# Copy to .env.local for local development. Never commit real values.
# Auth.js requires a fresh random secret (at least 32 characters):
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-generated-random-secret-of-at-least-32-characters"

# Google OAuth Web client credentials from Google Cloud Console:
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Auth.js v5 infers the request host on Vercel; do not hard-code a preview URL here.
AUTH_TRUST_HOST="true"

# PostgreSQL connection for this environment. Use a dedicated development/preview DB,
# not the production DATABASE_URL, for preview deployments.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional: server-side FastAPI endpoint. It must point to an environment whose
# backend AUTH_SECRET matches this frontend's AUTH_SECRET.
BACKEND_URL="http://127.0.0.1:8000"
