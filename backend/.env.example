# Required shared secret: generate at least 32 random bytes.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use the same value in the frontend and backend; never commit the real value.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Exact browser origins if a browser calls FastAPI directly.
# The Next.js server proxy uses server-to-server traffic and does not need CORS.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Self-hosted OpenAI-compatible text inference endpoint.
# Example for Docker Compose: http://model-server:8080/v1
# Example on the same machine: http://127.0.0.1:8080/v1
# In production, use a private/internal service address.
MODEL_SERVER_BASE_URL=http://127.0.0.1:8080/v1
NISAKSHI_MODEL_ID=nisakshi-local
# Optional additional model IDs that the UI may request, comma-separated.
NISAKSHI_ALLOWED_MODELS=nisakshi-local
# Optional only if the private inference service requires bearer authentication.
MODEL_SERVER_API_KEY=

# Optional self-hosted image endpoint. The endpoint must be OpenAI-compatible and
# return image data in data[0].b64_json; NISAKSHI never fetches a returned image URL.
IMAGE_SERVER_BASE_URL=
IMAGE_MODEL_ID=
IMAGE_ALLOWED_MODELS=
IMAGE_SERVER_API_KEY=

# Cloud runtime
PORT=8000
