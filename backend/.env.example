# Current provider configuration (replaced in Phase 2 by self-hosted inference)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=your-configured-text-model
GEMINI_IMAGE_MODEL=your-configured-image-model

# Required shared secret: generate at least 32 random bytes.
# Example command: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use the same high-entropy value for frontend and backend; do not commit it.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Comma-separated exact browser origins, no wildcard regex.
# Production: set this to the exact frontend origin(s), e.g. https://your-app.example
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
