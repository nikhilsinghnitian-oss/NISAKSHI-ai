# Copy this file to .env. Do not commit your real .env file.
# Generate a secret using:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Model file you have independently downloaded and license-checked.
# Put it at ./models/model.gguf by default (the models folder is gitignored).
MODEL_FILE=model.gguf
NISAKSHI_MODEL_ID=nisakshi-local
NISAKSHI_ALLOWED_MODELS=nisakshi-local
MODEL_CONTEXT_SIZE=4096
# CPU-only default supports most systems; only set >0 with a compatible GPU-enabled image.
MODEL_GPU_LAYERS=0

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MODEL_SERVER_API_KEY=
IMAGE_SERVER_BASE_URL=
IMAGE_MODEL_ID=
IMAGE_ALLOWED_MODELS=
IMAGE_SERVER_API_KEY=
